# Copy to .env (gitignored): cp env.example .env
# Read by docker compose and ./archive.

# Directory that contains archive collection folders (<name>/archive, <name>/indexes).
# For tgno this is the root of the go-archive-tgno clone, which contains tgno/.
# Default: ./collections
ARCHIVE_DIR=../go-archive-tgno

# Which archives pywb should serve. A non-empty folder ARCHIVE_DIR/<name> is used
# as is; anything else is fetched from github.com/gathering/go-archive-<name>.
# Empty = all years (tg21 tg22 tg23 tg24 tgno), same as production.
ARCHIVES=tgno
